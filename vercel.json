{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/landing.html", "destination": "/invitacion/", "permanent": true },
    { "source": "/landing", "destination": "/invitacion/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
